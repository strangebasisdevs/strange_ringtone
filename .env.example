# strange_ringtone settings: the core's (docs/PLAN.md, section 5.7), then the
# optional fetcher image's (section 6). Copy this file to .env, which git
# ignores, and fill it in. compose.example.yaml gives both services this one
# file; each server reads only its own variables, checks every value at
# startup and refuses to start if one is invalid.
#
# The core has no secrets yet. A future secret will arrive as a *_FILE variable
# naming a file that holds it, never as a value in this file, and it will have
# no usable default.

# Required. The origin browsers use to reach the app: scheme, host and an
# optional port, with no path and no trailing slash, for example
# https://ringtones.example.internal
# Write it in lowercase and leave out a default port: every POST must carry an
# Origin header equal to it byte for byte, and browsers send it that way.
PUBLIC_ORIGIN=

# Optional settings, shown with their defaults. An empty value means the
# default. Remove the leading "# " to change one.

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted,
# for example 192.0.2.0/24. Empty trusts none, so behind a proxy every client
# shares the proxy's address and the per-client rate limit becomes global.
# TRUSTED_PROXIES=

# Longest clip in seconds, 1 to 40. iOS refuses ringtones over 30 s.
# MAX_CLIP_SECONDS=30

# Loudness target the UI starts with, in LUFS, -24 to -9. The slider moves in
# 0.1 LU steps, so the page rounds a value with more decimals to one.
# DEFAULT_TARGET_LUFS=-14

# Wall-clock limit in seconds for each ffmpeg run, at least 1.
# RENDER_TIMEOUT_SECONDS=20

# Renders allowed at once; more answer 503 with Retry-After. At least 1.
# RENDER_CONCURRENCY=2

# Renders allowed per client address in any 60-second window. At least 1.
# RATE_LIMIT_RENDERS_PER_MINUTE=10

# Seconds a rendered tone stays downloadable before it is deleted. At least 1.
# RESULT_TTL_SECONDS=600

# Rendered tones held at once; renders answer 503 while it is full. At least 1.
# MAX_RESULTS=50

# Show the YouTube box in the UI (true/false, 1/0, yes/no). The core never
# calls the fetcher itself.
# FETCH_ENABLED=false

# The AGPL source link shown in the app, an absolute http(s) URL. The image
# bakes it in at build time; forks override it.
# SOURCE_URL=https://github.com/strangebasisdevs/strange_ringtone

# The release version, used in static asset URLs. The image sets it at build
# time; outside a release it is dev.
# VERSION=dev

# ---- Fetcher image (opt-in, docs/PLAN.md section 6) ----
# Read only by the fetcher. It shares PUBLIC_ORIGIN (required, the same value:
# the proxy serves the fetcher's /fetch/ paths on the core's origin) and
# TRUSTED_PROXIES from above. Set FETCH_ENABLED=true above as well, or the page
# never shows the YouTube box.

# Longest video in seconds, 1 to 600. Keep it at or below 600: the page refuses
# to decode anything longer than 10 minutes.
# FETCH_MAX_SECONDS=600

# Largest audio download in bytes, 1048576 to 536870912 (40 MiB by default).
# The fetcher's /tmp must hold two of them plus 16 MB (README, Deployment
# contract).
# FETCH_MAX_BYTES=41943040

# Wall-clock limit in seconds for each yt-dlp run, 1 to 600.
# FETCH_TIMEOUT_SECONDS=120

# Fetches allowed per client address in any 60-second window. At least 1.
# RATE_LIMIT_FETCHES_PER_MINUTE=5

# Seconds a fetched file waits for the page to collect it. At least 1.
# FETCH_RESULT_TTL_SECONDS=600

# An outbound proxy for yt-dlp, for example one that allows only YouTube's
# hosts. http:// proxies only (yt-dlp without the requests package), with no
# credentials in the URL. These three are the only parts of the fetcher's
# environment that reach yt-dlp.
# HTTPS_PROXY=http://proxy.example.internal:3128
# HTTP_PROXY=http://proxy.example.internal:3128
# NO_PROXY=
