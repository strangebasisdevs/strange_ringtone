# strange_ringtone settings: the core's (docs/PLAN.md, section 5.7), then the
# optional fetcher image's (section 6). Copy this file to .env, which git
# ignores, and fill it in. compose.example.yaml gives the core, the fetcher and
# its runner this one file; each server reads only its own variables, checks
# every value at startup and refuses to start if one is invalid.
#
# The core has no secrets yet. A future secret will arrive as a *_FILE variable
# naming a file that holds it, never as a value in this file, and it will have
# no usable default.

# Required. The origin browsers use to reach the app: scheme, host and an
# optional port, with no path and no trailing slash, for example
# https://ringtones.example.internal
# Write it in lowercase and leave out a default port: every POST must carry an
# Origin header equal to it byte for byte, and browsers send it that way.
PUBLIC_ORIGIN=

# Optional settings, shown with their defaults. An empty value means the
# default. Remove the leading "# " to change one.

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted,
# for example 192.0.2.0/24. Empty trusts none, so behind a proxy every client
# shares the proxy's address and the per-client rate limit becomes global.
# This value is the core's: compose.example.yaml sets the fetcher's
# TRUSTED_PROXIES to empty in its own environment, which wins over this file,
# because the runner reaches the fetcher over the `jobs` network and Docker
# may give that network another subnet when it recreates it. If you give the
# fetcher a value anyway, never list a range that covers `jobs`, or it would
# trust an X-Forwarded-For the runner wrote (README, Networks).
# TRUSTED_PROXIES=

# Longest clip in seconds, 1 to 40. iOS refuses ringtones over 30 s.
# MAX_CLIP_SECONDS=30

# Loudness target the UI starts with, in LUFS, -24 to -9. The slider moves in
# 0.1 LU steps, so the page rounds a value with more decimals to one.
# DEFAULT_TARGET_LUFS=-14

# Wall-clock limit in seconds for each ffmpeg run, at least 1.
# RENDER_TIMEOUT_SECONDS=20

# Renders allowed at once; more answer 503 with Retry-After. At least 1.
# RENDER_CONCURRENCY=2

# Renders allowed per client address in any 60-second window. At least 1.
# RATE_LIMIT_RENDERS_PER_MINUTE=10

# Seconds a rendered tone stays downloadable before it is deleted. At least 1.
# RESULT_TTL_SECONDS=600

# Rendered tones held at once; renders answer 503 while it is full. At least 1.
# MAX_RESULTS=50

# Show the YouTube box in the UI (true/false, 1/0, yes/no). The core never
# calls the fetcher itself.
# FETCH_ENABLED=false

# The AGPL source link shown in the app, an absolute http(s) URL. The image
# bakes it in at build time; forks override it.
# SOURCE_URL=https://github.com/strangebasisdevs/strange_ringtone

# The release version, used in static asset URLs. The image sets it at build
# time; outside a release it is dev.
# VERSION=dev

# ---- Fetcher image (opt-in, docs/PLAN.md section 6) ----
# Read by the fetcher and its runner, each its own rows, from this one file.
# The fetcher shares PUBLIC_ORIGIN (required, the same value: the proxy serves
# the fetcher's /fetch/ paths on the core's origin) from above. It reads
# TRUSTED_PROXIES too, but compose.example.yaml gives it an empty one of its
# own, so the one above is the core's (see its comment). The runner reads
# neither. Set FETCH_ENABLED=true above as well, or
# the page never shows the YouTube box. compose.example.yaml sets HTTPS_PROXY
# on the runner service itself, pointing at the forwarder, and the forwarder
# reads no setting at all.

# Read by the runner. Longest video in seconds, 1 to 600. Keep it at or below
# 600: the page refuses to decode anything longer than 10 minutes.
# FETCH_MAX_SECONDS=600

# Read by both. Largest audio download in bytes, 1048576 to 536870912
# (40 MiB by default): the runner caps what yt-dlp downloads, and the fetcher
# what it accepts from the runner. The fetcher's /tmp must hold two of them
# and the runner's one plus 16 MB (README, Deployment contract).
# FETCH_MAX_BYTES=41943040

# Read by both. The runner's wall-clock limit in seconds for each yt-dlp run,
# 1 to 600; the fetcher waits that long plus 15 s for the answer, so set it
# here, once, for both.
# FETCH_TIMEOUT_SECONDS=120

# Read by the fetcher. Fetches allowed per client address in any 60-second
# window. At least 1.
# RATE_LIMIT_FETCHES_PER_MINUTE=5

# Read by the fetcher. Seconds a fetched file waits for the page to collect
# it. At least 1.
# FETCH_RESULT_TTL_SECONDS=600

# Read by both. The fetcher and the runner each refuse to start when their
# container has a default route (IPv4 or IPv6), because something other than
# the forwarder could then carry traffic out. true turns that check off; set
# it only where egress is filtered another way (a NetworkPolicy, a firewall).
# Each also refuses when /proc/net/route can't be read or parsed (or
# ipv6_route, when it exists), so a development machine without /proc sets it
# too. The IPv4 check sees the main routing table only, not one an `ip rule`
# selects (README).
# FETCH_ALLOW_DEFAULT_ROUTE=false

# Read by the runner. Where the runner can't kill and reap what a yt-dlp run
# leaves behind (it is not its container's PID 1, as under an init), it
# refuses to start; true lets it serve without that sweep instead. Set it
# only for a local run or on a host that can't run the runner as PID 1,
# never for a deployment that can: compose.example.yaml runs the runner as
# PID 1 and never needs it. As PID 1 the runner sweeps whatever this says.
# FETCH_ALLOW_NO_SWEEP=false

# Read by the fetcher. Where the fetcher finds its runner: http://host[:port]
# and nothing else, no credentials. The default is the compose service name.
# The fetcher treats the runner's answers as untrusted whatever this points
# at.
# FETCH_RUNNER_URL=http://fetcher-runner:8080

# Read by the runner. The outbound proxy yt-dlp uses. compose.example.yaml
# gives the runner service HTTPS_PROXY=http://fetcher-forwarder:3128
# directly, which wins over this file, so set a value here only for a
# deployment that gates egress another way. http:// proxies only (yt-dlp
# without the requests package), with no credentials in the URL. These three
# are the only parts of the runner's environment that reach yt-dlp.
# HTTPS_PROXY=http://proxy.example.internal:3128
# HTTP_PROXY=http://proxy.example.internal:3128
# NO_PROXY=
